---
import * as fs from "node:fs";
import '../styles/style.css'
import {logger} from '../js/logger.ts'

let imageFilenames: string[] = [];
const imageRefreshInterval = import.meta.env.IMAGE_REFRESH_INTERVAL || 86400000; //default 1 day
const imageFolderPath = import.meta.env.IMAGE_FILE_PATH || 'public/images';

imageFilenames = fs.readdirSync(imageFolderPath);
setInterval(() => {
    logger.info("Pick up files from: " + imageFolderPath);
    imageFilenames = fs.readdirSync(imageFolderPath);
    logger.info("imageRefreshInterval:", imageRefreshInterval)
}, imageRefreshInterval)
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width" initial-scale="1.0"/>
    <meta name="generator" content={Astro.generator}/>
    <script src="../js/carousel.ts"></script>

    <title>Astro</title>
</head>
<body>
<div class="carousel">
    {
        imageFilenames.map((filename, index) => {
            const firstSlide = index === 0;
            if (firstSlide) {
                return (
                        <div class="carousel-item active">
                            <img src={"images/" + filename} alt={filename}/>
                        </div>
                )
            } else {
                return (
                        <div class="carousel-item">
                            <img src={"images/" + filename} alt={filename}/>
                        </div>
                )
            }

        })
    }
</div>
</body>
</html>
